{
  "openapi": "3.1.0",
  "info": { "title": "KebuGram Plugin Marketplace — 6.5", "version": "0.1.0", "description": "Discovery, install, permissions, CSP, partner adapters — sandboxed iframe runtime. Zod → OpenAPI." },
  "servers": [{ "url": "http://localhost:4103" }],
  "paths": {
    "/plugins": { "get": { "responses": { "200": { "description": "List", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/PluginManifest" } } } } } } } } },
    "/plugins/{id}/install": { "post": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Installed" }, "403": { "description": "Permission denied" } } } },
    "/plugins/{id}/uninstall": { "post": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Uninstalled" } } } }
  },
  "components": { "schemas": {
    "PluginManifest": { "type": "object", "required": ["id", "name", "version", "permissions", "csp", "entryUrl"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "version": { "type": "string" }, "permissions": { "type": "array", "items": { "type": "string", "enum": ["geo:coarse", "geo:precise", "pay:intent", "ads:read", "storage:local"] } }, "csp": { "type": "string" }, "entryUrl": { "type": "string", "format": "uri" }, "isShowcase": { "type": "boolean" } } }
  } }
}
